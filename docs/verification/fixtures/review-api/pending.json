  ],
  "refusals": [
    {
      "case": "unknown cursor",
      "request": {
        "jsonrpc": "2.0",
        "id": 50,
        "method": "kb/review.pending",
        "params": {
          "kb_id": "0b8c5d0e-3f4a-4c61-9d2e-5a7b8c9d0e1f",
          "cursor": "not-a-cursor"
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 50,
        "error": {
          "code": -32602,
          "message": "cursor is not one this method issued",
          "data": {
            "kind": "invalid_params",
            "param": "cursor"
          }
        }
      }
    }
  ]
}
