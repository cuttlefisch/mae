{
  "$comment": "ADR-113 Amendment 4 fixture. JSON-RPC 2.0 POSTed to the daemon's OAuth listener with a bearer token, exactly as kb/query.* is. Clients branch on error.data.kind only; error.code is informative. Identifiers, hashes and times are examples; times are RFC 3339 UTC with milliseconds. Field names and kinds are normative.",
  "method": "kb/review.in_force",
  "description": "C10: the master list of documents in force, one row per document, under the KB's read access. `approver`/`publisher` are labels; for an imported revision `approver` is the attested name and `imported` is true. Paged with an opaque cursor; same limit clamping as kb/query.list.",
  "transport": {
    "http": "POST /",
    "headers": {
      "Authorization": "Bearer <the person's IdP access token for this daemon's audience>",
      "Content-Type": "application/json"
    }
  },
  "examples": [
    {
      "name": "page 1",
      "request": {
        "jsonrpc": "2.0",
        "id": 53,
        "method": "kb/review.in_force",
        "params": {
          "kb_id": "0b8c5d0e-3f4a-4c61-9d2e-5a7b8c9d0e1f",
          "limit": 2
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 53,
        "result": {
