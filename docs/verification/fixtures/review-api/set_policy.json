{
  "$comment": "ADR-113 Amendment 4 fixture. JSON-RPC 2.0 POSTed to the daemon's OAuth listener with a bearer token, exactly as kb/query.* is. Clients branch on error.data.kind only; error.code is informative. Identifiers, hashes and times are examples; times are RFC 3339 UTC with milliseconds. Field names and kinds are normative.",
  "method": "kb/review.set_policy",
  "description": "Owner only, a person with a fresh second factor (C4, ADR-117 D6). Every field optional; the answer is the whole policy after the change. Each change is an event. `approval_record` is \"act\" (the default, B7) or \"signed_pdf\" (Amendment 4, E3); a change to it requires `reason`, recorded in its event.",
  "transport": {
    "http": "POST /",
    "headers": {
      "Authorization": "Bearer <the person's IdP access token for this daemon's audience>",
      "Content-Type": "application/json"
    }
  },
  "examples": [
    {
      "name": "turn review on",
      "request": {
        "jsonrpc": "2.0",
        "id": 59,
        "method": "kb/review.set_policy",
        "params": {
          "kb_id": "0b8c5d0e-3f4a-4c61-9d2e-5a7b8c9d0e1f",
          "review_enabled": true,
          "in_force_on_approval": false,
          "required_acts": [
            "reviewed",
            "approved"
          ],
          "reviewers": [
            {
              "group": "quality-reviewers"
            }
          ],
          "approvers": [
            {
              "group": "quality-approvers"
            }
          ],
          "approval_requires_mfa": true,
          "approval_requires_rendered_pdf": false,
          "approval_record": "signed_pdf",
          "reauth_max_age_secs": 300,
          "attachment_retention_days": 3650,
          "code_prefixes": [
            "PRO",
            "IT",
            "REG"
          ],
          "reason": "In-system approval is not yet accepted as equivalent to a signature; the signed PDF is the interim record of approval (Amendment 4, E3)."
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 59,
        "result": {
          "event_id": "ev-0000000002",
          "policy": {
            "review_enabled": true,
            "in_force_on_approval": false,
            "required_acts": [
              "reviewed",
              "approved"
            ],
            "reviewers": [
              {
                "group": "quality-reviewers"
              }
            ],
            "approvers": [
              {
                "group": "quality-approvers"
              }
            ],
            "approval_requires_mfa": true,
            "approval_requires_rendered_pdf": false,
            "approval_record": "signed_pdf",
            "reauth_max_age_secs": 300,
            "attachment_retention_days": 3650,
            "code_prefixes": [
              "PRO",
              "IT",
              "REG"
            ]
          }
        }
      }
    }
  ],
  "refusals": [
    {
      "case": "not the owner",
      "request": {
        "jsonrpc": "2.0",
        "id": 60,
        "method": "kb/review.set_policy",
        "params": {
          "kb_id": "0b8c5d0e-3f4a-4c61-9d2e-5a7b8c9d0e1f",
          "review_enabled": false
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 60,
        "error": {
          "code": -32603,
          "message": "only the KB owner may change the review policy",
          "data": {
            "kind": "role_forbidden"
          }
        }
      }
    },
    {
      "case": "a named approver is not a person",
      "request": {
        "jsonrpc": "2.0",
        "id": 61,
        "method": "kb/review.set_policy",
        "params": {
          "kb_id": "0b8c5d0e-3f4a-4c61-9d2e-5a7b8c9d0e1f",
          "approvers": [
            {
              "member": "SHA256:YWdlbnRrZXlleGFtcGxlMDAwMQ"
            }
          ]
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 61,
        "error": {
          "code": -32603,
          "message": "named performers must be members bound as persons",
          "data": {
            "kind": "performer_not_person",
            "member": "SHA256:YWdlbnRrZXlleGFtcGxlMDAwMQ"
          }
        }
      }
    },
    {
      "case": "retention below the operator's floor",
      "request": {
        "jsonrpc": "2.0",
        "id": 62,
        "method": "kb/review.set_policy",
        "params": {
          "kb_id": "0b8c5d0e-3f4a-4c61-9d2e-5a7b8c9d0e1f",
          "attachment_retention_days": 30
        }
      },
      "response": {
        "jsonrpc": "2.0",
        "id": 62,
        "error": {
          "code": -32603,
          "message": "the KB's period cannot be shorter than the operator's floor",
          "data": {
            "kind": "retention_below_floor",
            "floor_days": 3650
          }
        }
      }
    }
  ]
}
