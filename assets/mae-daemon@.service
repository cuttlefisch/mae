# MAE Daemon — per-tenant process isolation template (ADR-060 Phase E).
#
# For tenants that must not share a process or failure domain at all — the case
# where Phases A-D's in-process multi-tenant isolation (mae-daemon.service, the
# single shared-process unit), however correct, is still one crash or one
# resource-exhaustion event away from affecting a co-resident tenant. Each
# template instantiation gets its own process, its own PID, its own
# daemon.toml, and its own data directory — genuine OS-level isolation, not
# merely logical separation within one process.
#
# This is a systemd TEMPLATE unit, directly mirroring the already-shipped
# mae-headless@.service pattern: one instance per TENANT, instantiated with
# the tenant name as the instance name, systemd-escaped.
#
# **Linux-only, per the project's Gate W cross-platform scoping** (ADR-060
# Phase E) — mae-daemon is confirmed never expected to run on macOS or
# Windows as a deployed service.
#
# Prerequisite: create a per-tenant config file BEFORE starting the unit.
# Start from the per-instance template, which already sets every path that
# needs to be unique:
#   cp daemon-instance-config.toml ~/.config/mae/daemon-<tenant>.toml
#   # replace INSTANCE with the tenant name; pick unused ports
#
# EIGHT resources must be unique per instance and --data-dir below scopes only
# four. In particular identity_dir / authorized_keys / keystore default to the
# SHARED ~/.local/share/mae/collab/ regardless of --data-dir, which under this
# unit is doubly wrong: ProtectHome=read-only plus the ReadWritePaths below
# make that directory unwritable here, so a key-mode instance relying on the
# default cannot create its identity at all. The template sets all three inside
# the tenant's own tree. See docs/DAEMON_ADMIN.md §1.
#
# Verify before starting a second instance (exits non-zero on any shared
# resource, so it works in a deploy gate):
#   mae-daemon doctor --config ~/.config/mae/daemon-<tenant>.toml \
#                     --compare-with ~/.config/mae/daemon-<other>.toml
#
# Installation:
#   cp mae-daemon@.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now 'mae-daemon@'"$(systemd-escape <tenant>)"'.service'
#
# Logs: journalctl --user -u 'mae-daemon@*' -f

[Unit]
Description=MAE Daemon (tenant: %i)
Documentation=https://github.com/cuttlefisch/mae
After=network.target

[Service]
Type=simple
# %i is the systemd-escaped tenant name. --config points at a per-tenant
# daemon.toml (see the prerequisite above); --data-dir gives this instance
# its own KB storage directory, fully separate from every other tenant's
# instance — the actual process-level isolation this phase exists to provide.
ExecStart=%h/.local/bin/mae-daemon --config %h/.config/mae/daemon-%i.toml --data-dir %h/.local/share/mae/tenants/%i
Restart=on-failure
RestartSec=5

# Security hardening
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/.local/share/mae/tenants/%i %h/.config/mae %t
PrivateTmp=yes

# Resource limits
LimitNOFILE=65536

[Install]
WantedBy=default.target
