    "lint": "eslint . --ext .ts,.mjs --max-warnings=0"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "typescript": "^5.9.3",
    "vite-node": "^2.1.9",
    "vitest": "^2.1.9",
    "yaml": "^2.8.2"
  }
}
