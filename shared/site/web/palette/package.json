{
  "name": "mae-site-palette",
  "version": "0.0.0",
  "private": true,
  "description": "MAE site palettes: CSS variables and JSON tokens, checked for contrast when derived",
  "license": "GPL-3.0-or-later",
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "vite-node src/build.ts",
    "doom": "vite-node scripts/from-doom.mjs",
